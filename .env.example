# Copy to .env.local for optional integrations. npm run dev works with no env file.
# Use the canonical public HTTPS origin, without a trailing slash, on Vercel.
APP_URL=http://localhost:3000

# Hosted Supabase project and auth. Keep DATABASE_URL on the server.
DATABASE_URL=
# Optional PEM from Supabase Database Settings for a dedicated certificate authority.
# SUPABASE_DB_CA_CERT=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Stripe test mode. The webhook secret is distinct from the API key.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional short-term hosted demo fallback when both Stripe values are unset.
# AVOPORE_SIMULATE_PAYMENTS=1

# Booking confirmation email and the scheduled expiry endpoint.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CRON_SECRET=

# Optional local-only demo settings. Leave these unset on Vercel.
# AVOPORE_DATA_DIR=
# AVOPORE_LOCAL_DEMO=1
# AVOPORE_DEMO_SESSION_SECRET=
